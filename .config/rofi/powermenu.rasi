configuration {
    location:                       0;
    font:                           "Font Awesome 7 Free:style=Regular 25";
}

* {
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;

  background: #11111bE4;
  background-alt: #11111bE4;
  foreground: #eeeeee;
  foreground-alt: #9399b2;

  selected: #eba0ac;
  active: #C29ED6;
  border: #31303E;
  urgent: #f38ba8;

  background-color: @background;
  text-color: @foreground;
}

window {
    background-color:               @background;
    border:                         2px;
    border-color:                   @border;
    border-radius:                  0px;
    width:                          490px;
    height:                         130px;
    anchor: southeast;
    location: southeast;
    x-offset: -2px;
    y-offset: -8px;
}

listview {
    background-color:               transparent;
    columns:                        1;
    lines:                          5;
    spacing:                        48px;
    layout:                         horizontal;
}

mainbox {
    background-color:               transparent;
    children:                       [ listview ];
    padding:                        40px;
}

element {
    background-color:               transparent;
    text-color:                     @foreground-alt;
    orientation:                    horizontal;
}

element-text {
    background-color:               inherit;
    text-color:                     inherit;
    expand:                         false;
    horizontal-align:               0.5;
    vertical-align:                 0.5;
    margin:                         0px;
}

element selected {
    background-color:               transparent;
    text-color:                     @active;
    border:                         0px;
    border-color:                   @selected;
}
